CORS_PROXY_HOST=127.0.0.1
CORS_PROXY_PORT=9800
CORS_PROXY_DB=./data/corsproxy.db
# Set strong, unique values before public deployment.
CORS_PROXY_ADMIN_KEY=replace-me
# Comma-separated API keys. A generated development key is used only when empty.
CORS_PROXY_API_KEYS=
# Host suffixes permitted by /v1/forward. Empty means no public target is allowed.
CORS_PROXY_ALLOWED_TARGETS=api.example.com,.example.com
CORS_PROXY_ALLOWED_ORIGINS=https://app.example.com
# Optional, comma-separated Cloudflare-fronted hostnames to probe using SNI.
CF_TEST_HOSTS=
# Use `serve --scheduler internal` or schedule CLI jobs externally, never both.
CORS_PROXY_SCHEDULER=off

